# Supply-chain hardening (pnpm 11+). See supply-chain-risk-mitigation skill.
# 24h quarantine on newly-published packages — blocks fresh-version attacks
# (TanStack / SAP CAP malicious versions were pulled within ~4h of publish).
minimumReleaseAge=1440
# Block git/tarball transitive deps — closes the "hidden payload in a subdep" vector.
blockExoticSubdeps=true
